<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">#F04E00</item>
        <item name="colorPrimaryDark">#1a1a2e</item>
        <item name="colorAccent">#F04E00</item>
    </style>

    <!-- Chrome colours match the web canvas (.mkt-canvas, #0F0C0A) so the
         status/navigation bars sit flush with the sign-in screen instead of
         showing a navy edge above a warm-black page. The splash theme below
         is deliberately left alone — it pairs with the light splash asset. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">#0F0C0A</item>
        <item name="android:navigationBarColor">#0F0C0A</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">#1a1a2e</item>
    </style>
</resources>