# Firebase Configuration
# Get these from Firebase Console > Project Settings > General > Your Apps
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend base URL (whatsapp-backend) — used for WhatsApp sync AND payments
VITE_BACKEND_URL=https://your-backend-host.com

# OTP kill-switch (frontend). Set to true to force Firebase Phone Auth and
# completely bypass the MSG91 multi-channel backend — handy while a WhatsApp
# authentication template is pending Meta approval or SMS DLT isn't done yet.
# Remove it (or set to false) to restore the normal WhatsApp→SMS→Voice flow.
# VITE_OTP_FORCE_FIREBASE=true   # (disabled — multi-channel WhatsApp OTP is live)

# WhatsApp Embedded Signup configuration. These are public browser IDs from
# Meta; app secrets, connection tokens, and encryption keys stay on Render.
VITE_META_APP_ID=your_meta_app_id
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID=your_embedded_signup_config_id
VITE_META_GRAPH_API_VERSION=v22.0

# WhatsApp number for the public “Talk to sales” link, digits only with country code.
# Defaults to the platform-owner number in code if omitted; set this explicitly in Vercel.
VITE_SALES_WHATSAPP_NUMBER=919653043939

# Razorpay public Key ID (safe for frontend). Secret stays on the backend only.
VITE_RAZORPAY_KEY_ID=rzp_test_TEzlUzUWqGLYNE
