# ---- Backend environment (whatsapp-backend) ----
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.

PORT=3001

# Browser origins allowed to call the API (comma-separated). Do not use * in production.
# These public HTTPS URLs are required in production before an admin can create
# website integration links. PUBLIC_FRONTEND_URL usually matches FRONTEND_URL.
FRONTEND_URL=https://your-frontend.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app
PUBLIC_FRONTEND_URL=https://your-frontend.vercel.app
PUBLIC_BACKEND_URL=https://your-backend-host.com

# Cloudflare Turnstile protects the public hosted lead form. The site key is
# safe to return to browsers; the secret key must remain only on Render.
TURNSTILE_SITE_KEY=0x4AAAAA_example_public_site_key
TURNSTILE_SECRET_KEY=0x4AAAAA_example_secret_key
PLATFORM_OWNER_PHONE=+919653043939

# WhatsApp Cloud API webhooks. VERIFY_TOKEN is used for Meta's GET challenge;
# APP_SECRET is required to validate every POST request signature.
WHATSAPP_VERIFY_TOKEN=your_random_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret

# Meta Embedded Signup and Cloud API. App secret and token encryption key are
# backend-only. Generate the encryption key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v22.0
WHATSAPP_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key

# Firebase Admin credentials are required on Render. Supply either the raw
# service-account JSON or its base64-encoded representation; never use VITE_.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account"}

# ---- Razorpay (popup checkout) ----
# Key ID is public; Key Secret must stay server-side only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Required for /api/billing/webhook/razorpay signature verification.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ---- PayU (redirect checkout) ----
PAYU_KEY=your_payu_key
PAYU_SALT=your_payu_salt
PAYU_MODE=test


# ── WhatsApp OTP via Meta Cloud API DIRECT (recommended, no BSP) ──────
# Send login OTPs straight through Meta's WhatsApp Cloud API using your own
# approved AUTHENTICATION template — no MSG91 / BSP needed. This is the
# preferred channel and is tried first (see OTP_CHANNEL_ORDER below).
#
# How to get these values:
#   WHATSAPP_OTP_PHONE_NUMBER_ID — WhatsApp Manager → Account tools →
#     Phone numbers → your number → "Phone number ID" (a long numeric id).
#   WHATSAPP_OTP_ACCESS_TOKEN — a LONG-LIVED System User token with the
#     whatsapp_business_messaging permission (Business Settings → Users →
#     System users → generate token). Do NOT use the short-lived Embedded
#     Signup token here.
#   WHATSAPP_OTP_TEMPLATE_NAME — your approved authentication template name
#     (e.g. codeskate_otp).
#   WHATSAPP_OTP_TEMPLATE_LANG — the template language code (e.g. en_US).
WHATSAPP_OTP_PHONE_NUMBER_ID=
WHATSAPP_OTP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANG=en_US

# ── Voice OTP via Plivo (outbound call with TTS, no DLT required) ─────
# Plivo makes an outbound call and reads the OTP code using Text-to-Speech.
# No DLT registration needed for voice calls in India. Get Auth ID/Token from
# plivo.com dashboard, buy an Indian local number (~₹250/month).
#   PLIVO_OTP_ANSWER_URL must point to the publicly accessible backend:
#   {PUBLIC_BACKEND_URL}/api/v1/otp/plivo-answer
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=918035410700
PLIVO_OTP_ANSWER_URL=https://codeskate-crm.onrender.com/api/v1/otp/plivo-answer

# ── Multi-channel OTP (WhatsApp → SMS → Voice) via MSG91 ──────────────
# Optional fallback provider. Leave MSG91_AUTH_KEY empty if you only use the
# direct-Meta channel above. If NEITHER Meta OTP nor MSG91 is configured, the
# frontend keeps using Firebase Phone Auth (default).
#
# Kill-switch: set OTP_MULTICHANNEL_ENABLED=false to force Firebase Phone Auth
# WITHOUT deleting any keys below. Use this while a WhatsApp authentication
# template is pending approval or SMS DLT isn't done yet. Remove it (or set to
# true) to re-enable direct-Meta / MSG91 OTP once ready.
OTP_MULTICHANNEL_ENABLED=false
MSG91_AUTH_KEY=
MSG91_SMS_TEMPLATE_ID=
MSG91_WHATSAPP_TEMPLATE_ID=
MSG91_WHATSAPP_NUMBER=
MSG91_VOICE_TEMPLATE_ID=
MSG91_SENDER_ID=
# Fallback order — first channel that accepts the request wins.
# "whatsapp_meta" = direct Meta Cloud API (recommended); "voice_plivo" = Plivo
# voice call (no DLT); "whatsapp"/"sms"/"voice" = MSG91 channels.
OTP_CHANNEL_ORDER=whatsapp_meta,voice_plivo,sms,voice
# Secret mixed into the OTP hash (set a long random string in production).
OTP_HASH_PEPPER=
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=30
OTP_MAX_SENDS_PER_WINDOW=5
OTP_SEND_WINDOW_SECONDS=3600
